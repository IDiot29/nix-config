# Decrypted to:
#   Darwin: /run/secrets/rendered/fish-secrets
#   NixOS:  /home/rivaldo/.config/fish/secrets.fish
fish_secrets: |
  # Add fish environment exports here.
  # Example:
  # set -gx MY_TOKEN "value"
  # Deka LLM
  set -gx DEKA_API_KEY "sk-..."
  # Opencode
  set -gx CONTEXT7_API_KEY "ctx7sk-..."
  set -gx EXA_API_KEY "..."
  set -gx FIRECRAWL_API_KEY "fc-..."
  set -gx MINIMAX_API_KEY "sk-..."
  set -gx OPENCODE_GO_API_KEY "sk-..."
  # Github Token
  set -gx GH_TOKEN "github_pat_..."
# Decrypted to:
#   Darwin: /run/secrets/rendered/nushell-secrets
#   NixOS:  /home/rivaldo/.config/nushell/secrets.nu
nushell_secrets: |
  export-env {
    # Add Nushell environment variables here.
    # Example:
    # $env.MY_TOKEN = "value"
    # Deka LLM
    $env.DEKA_API_KEY = "sk-..."
    # Opencode
    $env.CONTEXT7_API_KEY = "ctx7sk-..."
    $env.EXA_API_KEY = "..."
    $env.FIRECRAWL_API_KEY = "fc-..."
    $env.MINIMAX_API_KEY = "sk-..."
    $env.OPENCODE_GO_API_KEY = "sk-..."
    # Github Token
    $env.GH_TOKEN = "github_pat_..."
  }
# Decrypted to: /run/secrets/rendered/ssh-config
ssh_config: |
  Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

  Host server.example
    HostName 192.0.2.10
    User example
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Decrypted to:
#   NixOS only: /home/rivaldo/.config/winapps/winapps.conf
winapps_rdp_user: "YOUR_RDP_USERNAME"
winapps_rdp_pass: "YOUR_RDP_PASSWORD"
