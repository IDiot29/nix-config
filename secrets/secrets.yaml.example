# Decrypted to:
#   Darwin: /run/secrets/rendered/shell-secrets
#   NixOS:  /home/rivaldo/.config/shell-secrets.env
shell_secrets: |
  # Shared literal environment exports for Bash, Zsh, Fish, and Nushell.
  # Keep one quoted export per line; do not use expansion, inline comments, or
  # multiline values so every shell imports the same value.
  # Example:
  # export MY_TOKEN="value"
  # Deka LLM
  export DEKA_API_KEY="sk-..."
  # Opencode
  export CONTEXT7_API_KEY="ctx7sk-..."
  export EXA_API_KEY="..."
  export FIRECRAWL_API_KEY="fc-..."
  export MINIMAX_API_KEY="sk-..."
  export OPENCODE_GO_API_KEY="sk-..."
  # Github Token
  export GH_TOKEN="github_pat_..."
# Decrypted to: /run/secrets/rendered/ssh-config
ssh_config: |
  Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

  Host server.example
    HostName 192.0.2.10
    User example
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Decrypted to:
#   NixOS only: /home/rivaldo/.config/winapps/winapps.conf
winapps_rdp_user: "YOUR_RDP_USERNAME"
winapps_rdp_pass: "YOUR_RDP_PASSWORD"
