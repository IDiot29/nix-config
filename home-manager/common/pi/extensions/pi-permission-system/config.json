{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "piInfrastructureReadPaths": [
    "~/.pi/agent/skills",
    "~/.agents/skills",
    "/tmp/pi-clipboard-*",
    "/private/tmp/pi-clipboard-*",
    "/var/folders/*/T/pi-clipboard-*",
    "/private/var/folders/*/T/pi-clipboard-*"
  ],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.netrc": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/settings.json": "deny",
      "~/.config/fish/secrets.fish": "deny",
      "~/.config/nushell/secrets.nu": "deny",
      "~/.config/winapps/winapps.conf": "deny",
      "/run/secrets/rendered/fish-secrets": "deny",
      "/run/secrets/rendered/nushell-secrets": "deny"
    },
    "read": {
      "*": "allow",
      "~/Documents/Work/Straitpoint/Creds/*": "deny"
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "shred *": "deny",
      "wipefs *": "deny",
      "mkfs*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "diskutil erase*": "deny",
      "dd *": "deny",
      "chmod -R *": "deny",
      "chown -R *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "ask",
      "sudo *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/skills": "allow",
      "~/.pi/agent/skills/*": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow"
    }
  }
}
